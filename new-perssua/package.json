{
  "name": "new-perssua",
  "version": "1.0.0",
  "description": "Assistente de Reunião Invisível - Overlay desktop com transcrição e IA em tempo real",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "build:whisper": "bash scripts/build-whisper.sh",
    "build:whisper:win": "scripts\\build-whisper.bat"
  },
  "keywords": [
    "electron",
    "meeting-assistant",
    "transcription",
    "whisper",
    "ai-overlay",
    "openrouter"
  ],
  "author": "New Perssua Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "fluent-ffmpeg": "^2.1.2",
    "marked": "^11.0.0",
    "node-fetch": "^2.7.0"
  },
  "build": {
    "appId": "com.newperssua.app",
    "productName": "New Perssua",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.md",
      "!.gitignore"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.ico"
    }
  }
}
